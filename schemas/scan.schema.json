{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanArtifact",
  "type": "object",
  "required": [
    "status",
    "data_coverage",
    "review_signal",
    "pr",
    "files_changed",
    "review_comments",
    "threads",
    "codeowners_found",
    "policy_found",
    "product_boundary",
    "scan_partial"
  ],
  "$defs": {
    "comment_record": {
      "type": "object",
      "required": [
        "comment_id",
        "thread_id",
        "author",
        "body",
        "source"
      ],
      "properties": {
        "comment_id": { "type": "string" },
        "thread_id": { "type": "string" },
        "author": { "type": "string" },
        "body": { "type": "string" },
        "path": { "type": "string" },
        "source": { "enum": ["review_comment", "issue_comment"] },
        "reply_to_comment_id": { "type": "string" },
        "created_at": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "original_line": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "review_thread": {
      "type": "object",
      "required": [
        "thread_id",
        "root_comment_id",
        "participants",
        "roundtrips",
        "comments"
      ],
      "properties": {
        "thread_id": { "type": "string" },
        "root_comment_id": { "type": "string" },
        "path": { "type": "string" },
        "participants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "roundtrips": { "type": "integer", "minimum": 0 },
        "comments": {
          "type": "array",
          "items": { "$ref": "#/$defs/comment_record" }
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "status": { "enum": ["OK", "PARTIAL", "ERROR"] },
    "data_coverage": { "enum": ["FULL", "PARTIAL", "FAILED"] },
    "review_signal": { "enum": ["BLOCKED", "CLEAR", "UNKNOWN"] },
    "reason": { "type": "string" },
    "scan_partial": { "type": "boolean" },
    "repo_root": { "type": "string" },
    "branch": { "type": "string" },
    "pr": {
      "type": "object",
      "required": ["number", "title"],
      "properties": {
        "number": { "type": ["integer", "null"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "author": { "type": "string" },
        "base_branch": { "type": "string" },
        "head_branch": { "type": "string" },
        "head_oid": { "type": "string" },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "files_changed": { "type": "integer", "minimum": 0 },
    "review_comments": { "type": "integer", "minimum": 0 },
    "threads": { "type": "integer", "minimum": 0 },
    "codeowners_found": { "type": "boolean" },
    "policy_found": { "type": "boolean" },
    "product_boundary": {
      "type": "object",
      "required": [
        "category",
        "consumes_existing_review_comments",
        "generates_ai_reviews",
        "posts_pr_comments",
        "uses_llm_for_core_judgment"
      ],
      "properties": {
        "category": { "const": "post_review_triage_firewall" },
        "consumes_existing_review_comments": { "const": true },
        "generates_ai_reviews": { "const": false },
        "posts_pr_comments": { "const": false },
        "uses_llm_for_core_judgment": { "const": false }
      },
      "additionalProperties": true
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/comment_record" }
    },
    "issue_comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/comment_record" }
    },
    "review_threads": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_thread" }
    },
    "partial_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
